{
  "name": "@sujay/ui",
  "version": "1.0.0",
  "description": "GPU-accelerated native UI addon for Sujay using gpui",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "gpui",
    "gpu",
    "ui"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "sujay-ui",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.2.0"
  }
}
