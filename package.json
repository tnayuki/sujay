{
  "name": "sujay",
  "version": "0.1.0",
  "description": "AI DJ Application",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "cargo run --manifest-path packages/app/Cargo.toml",
    "build": "cargo build --manifest-path packages/app/Cargo.toml --release",
    "bundle": "cargo bundle --release --manifest-path packages/app/Cargo.toml",
    "lint": "cargo clippy --manifest-path packages/app/Cargo.toml --all-targets"
  },
  "author": {
    "name": "Toru Nayuki",
    "email": "tnayuki@icloud.com"
  },
  "license": "MIT"
}
